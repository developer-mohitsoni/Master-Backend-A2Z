{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",                   
    "moduleResolution": "nodenext",
    "lib": ["ES2024", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "incremental": true, 
    "composite": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
